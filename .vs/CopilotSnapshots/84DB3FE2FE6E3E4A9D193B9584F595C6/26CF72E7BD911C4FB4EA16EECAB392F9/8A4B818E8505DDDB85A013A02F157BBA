@model personapi_dotnet.Models.Entities.Estudio

<h1>Editar Estudio</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" name="CcPer" value="@Model.CcPer" />
    <input type="hidden" name="IdProf" value="@Model.IdProf" />
    <div class="form-group">
        <label asp-for="IdProf">Id Estudiante: @Model.CcPer</label>
    </div>
    <div class="form-group">
        <label asp-for="Univer">Universidad:</label>
        <input asp-for="Univer" type="text" class="form-control" id="Univer" name="Univer" value="@Model.Univer" />
    </div>
    <div class="form-group">
        <label asp-for="Fecha">Fecha:</label>
        <input asp-for="Fecha" type="date" class="form-control" id="Fecha" name="Fecha" value="@Model.Fecha" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>