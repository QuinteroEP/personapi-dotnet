@model personapi_dotnet.Models.Entities.Profesion

<h1>Editar Profesion</h1>
<form asp-action="Edit" asp-controller="Profesion" method="post">
 <input type="hidden" name="Id" value="@Model.Id" />
 <div class="form-group">
        <label asp-for="Nom">Nombre:</label>
        <input asp-for="Nom" type="text" class="form-control" id="Nom" name="Nom" value="@Model.Nom" required />
 </div>
 <div class="form-group">
        <label asp-for="Des">Descripcion:</label>
        <textarea asp-for="Des" class="form-control" id="Des" name="Des">@Model.Des</textarea>
 </div>
 <button type="submit" class="btn btn-primary">Guardar</button>
</form>